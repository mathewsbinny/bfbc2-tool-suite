__pycache__/
*.pyc

# hello_imgui window layout, per user
BFBC2_*.ini

# built locally (bfbc2-shader-tools/native/build.bat)
*.exe
*.obj

# built by renderqa.py (bfbc2-shader-tools/native/build.bat build)
build/

# the Rust core: cargo's build folder, and the Python module rust/build_native.py builds into core/bfbc2core
rust/target/
*.pyd
# the binaries build_native.py copies out of cargo's build folder (round D1: rust-targets\<checkout>, outside the
# checkout): bfbc2.exe, bfbc2-editor.exe, mapexport.exe - built outputs only
bin/
core/bfbc2core/bc2_native*.so
core/bfbc2core/bc2_native.pyd.*
core/bfbc2core/bc2_native.json
core/bfbc2core/bc2_native.json.tmp

# a personal override of the application icon (round I1): read by the builds and the hub before the committed
# design/icons/app.ico, never committed (README.md, "The application icon")
design/icons/local/
